{
  "name": "@arimaone/arimark",
  "version": "0.1.0",
  "description": "A minimalist, block-based Markdown editor for Vue 3 built on Milkdown Crepe.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/arimark.cjs",
  "module": "./dist/arimark.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/arimark.js",
      "require": "./dist/arimark.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arimaone/arimark.git"
  },
  "homepage": "https://github.com/arimaone/arimark#readme",
  "bugs": {
    "url": "https://github.com/arimaone/arimark/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "markdown",
    "editor",
    "milkdown",
    "crepe",
    "prosemirror",
    "block-editor",
    "frontmatter"
  ],
  "scripts": {
    "dev": "vite serve playground --config ./vite.config.js",
    "build": "vite build && npm run build:types",
    "build:types": "cp src/index.d.ts dist/index.d.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview playground --config ./vite.config.js"
  },
  "dependencies": {
    "@milkdown/core": "^7.6.3",
    "@milkdown/crepe": "^7.6.3",
    "@milkdown/ctx": "^7.6.3",
    "@milkdown/plugin-listener": "^7.6.3",
    "@milkdown/prose": "^7.6.3",
    "@milkdown/utils": "^7.6.3"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "vite": "^6.2.0",
    "vitest": "^3.0.7",
    "vue": "^3.5.25"
  }
}
